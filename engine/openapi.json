  "components": {
    "schemas": {
      "Backup": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "made": {
            "type": "string",
            "title": "Made"
          },
          "size": {
            "type": "integer",
            "title": "Size"
          },
          "beforeRestoring": {
            "type": "boolean",
            "title": "Beforerestoring"
          },
          "fromExport": {
            "type": "boolean",
            "title": "Fromexport"
          },
          "byHand": {
            "type": "boolean",
            "title": "Byhand"
          }
        },
        "type": "object",
        "required": [
          "name",
          "made",
          "size",
          "beforeRestoring",
          "fromExport",
          "byHand"
        ],
        "title": "Backup"
      },
      "Backups": {
        "properties": {
          "backups": {
            "items": {
              "$ref": "#/components/schemas/Backup"
            },
            "type": "array",
            "title": "Backups"
          },
          "restored": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Restored"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "backups",
          "restored"
        ],
        "title": "Backups"
      },
      "Damage": {
        "properties": {
